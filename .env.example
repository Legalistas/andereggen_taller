# ─────────────────────────────────────────────────────────────
# Ejemplo de variables de entorno.
# Copiá este archivo como `.env` y completá los valores.
# ─────────────────────────────────────────────────────────────

# ─── Base de datos (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/Andereggen?schema=public"

# ─── API base URL (cliente Next.js) ──────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ─── Better Auth ─────────────────────────────────────────────
# Secret para firmar cookies/JWTs. Generá con: openssl rand -base64 32
BETTER_AUTH_SECRET="generar-un-secret-aleatorio-de-32-chars-minimo"
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────
# Redirect URI en Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se expone al cliente para Google One Tap login (mismo valor que GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Email / SMTP ────────────────────────────────────────────
# SMTP_PROVIDER: "gmail" (service integrado) o "generic" (host/port manual)
SMTP_PROVIDER=gmail

# Para Gmail: usar un App Password (NO la contraseña normal).
# Guía: https://support.google.com/accounts/answer/185833
SMTP_USER=tu-email@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Solo si SMTP_PROVIDER=generic (SendGrid, Brevo, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false   # true para puerto 465

# Dirección visible en el "De" de los correos (opcional, fallback a SMTP_USER)
SMTP_FROM="Andereggen Taller Automotor <no-reply@andereggen.com.ar>"
