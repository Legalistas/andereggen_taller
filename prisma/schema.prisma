// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BETTER AUTH — CORE MODELS
// ============================================================

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  // Teléfono / celular — spec 8.2 (datos mínimos del actor)
  phone            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // admin plugin (field `role` del plugin mapeado a columna adminRole)
  adminRole        String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  // lastLoginMethod plugin
  lastLoginMethod  String?
  // twoFactor plugin
  twoFactorEnabled Boolean   @default(false)

  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  // Domain custom role (many-to-one con Role)
  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])
  isActive Boolean @default(true)

  // Business relations
  leadsCreated                 Lead[]                 @relation("LeadCreatedBy")
  leadsAsInspector             Lead[]                 @relation("LeadInspector")
  leadsAsInsurance             Lead[]                 @relation("LeadInsuranceAgent")
  budgetsCreated               Budget[]               @relation("BudgetCreatedBy")
  budgetEmailsSent             BudgetEmailLog[]       @relation("BudgetEmailSentBy")
  partMovements                PartMovement[]         @relation("PartMovementCreatedBy")
  toolsAssigned                Tool[]                 @relation("ToolAssignedTo")
  paymentsCreated              Payment[]              @relation("PaymentCreatedBy")
  repairsCreated               Repair[]               @relation("RepairCreatedBy")
  repairsAssigned              Repair[]               @relation("RepairMechanic")
  repairInvoicesCreated        RepairInvoice[]        @relation("RepairInvoiceCreatedBy")
  repairInvoicePaymentsCreated RepairInvoicePayment[] @relation("RepairInvoicePaymentCreatedBy")
  cashMovementsCreated         CashMovement[]         @relation("CashMovementCreatedBy")
  pendingCashPaymentsCreated   PendingCashPayment[]   @relation("PendingCashPaymentCreatedBy")
  monthlyKpiEntriesCreated     MonthlyKpiEntry[]      @relation("MonthlyKpiEntryCreatedBy")
  purchasesCreated             Purchase[]             @relation("PurchaseCreatedBy")
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  // admin plugin
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// BETTER AUTH — TWO FACTOR PLUGIN
// ============================================================

model TwoFactor {
  id          String @id @default(uuid())
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// BETTER AUTH — JWT PLUGIN (JWKS)
// ============================================================

model Jwks {
  id         String   @id @default(uuid())
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// ============================================================
// DOMAIN — ROLES & PERMISSIONS (custom, separate from better-auth admin role)
// ============================================================

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // key estable (ej: "super_admin")
  label       String // display en español (ej: "Administrativo del Taller")
  type        RoleType         @default(INTERNAL)
  description String?
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  customers   Customer[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum RoleType {
  INTERNAL // Personal del taller
  EXTERNAL // Clientes / terceros (aseguradoras, peritos, etc.)
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

model Country {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String?    @unique // Código de país (AR, BR, etc.)
  states    State[]
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model State {
  id        String     @id @default(uuid())
  name      String
  countryId String
  country   Country    @relation(fields: [countryId], references: [id])
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, countryId])
}

model Customer {
  id        String  @id @default(uuid())
  name      String // Apellido y Nombre
  email     String  @unique
  phone     String // Teléfono o WhatsApp
  dni       String? // Número de documento
  dniType   String? // Tipo de documento (DNI, CUIL, CUIT, etc.)
  countryId String
  stateId   String
  city      String // Ciudad
  cp        String // Código postal
  address   String // Dirección
  roleId    String? // Enlace con el sistema de roles

  // Relaciones
  country  Country           @relation(fields: [countryId], references: [id])
  state    State             @relation(fields: [stateId], references: [id])
  role     Role?             @relation(fields: [roleId], references: [id])
  vehicles CustomerVehicle[]
  leads    Lead[]
  repairs  Repair[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([countryId])
  @@index([stateId])
  @@index([roleId])
}

model CustomerVehicle {
  id               String   @id @default(uuid())
  customerId       String
  brand            String // Marca
  model            String // Modelo
  year             String // Año
  domain           String // Dominio o patente
  chassis          String? // Nº de chasis
  /**
   * Color del vehículo — opcional, se completa cuando entra al taller. Sale en la Ficha Técnica.
   */
  color            String?
  /**
   * Pintura perlada tricapa — afecta el costo de la mano de obra de pintura
   */
  perladoTricapa   Boolean  @default(false)
  secure           String // Seguro (compañía del cliente)
  thirdPartySecure String // Seguro terceros (compañía del tercero)
  /**
   * "todo_riesgo" | "terceros" — tipo de cobertura del seguro propio
   */
  coverageType     String?
  /**
   * Importe de franquicia, solo aplica cuando coverageType == "todo_riesgo"
   */
  franchise        Decimal? @db.Decimal(14, 2)

  // Relación
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads    Lead[]
  repairs  Repair[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([domain])
}

// =====================================================
// CRM — Leads (embudo de oportunidades)
// =====================================================

enum LeadStatus {
  solicitud // Solicitud de presupuesto
  control // Control de presupuesto
  enviado // Presupuesto enviado
  refuerzo // Refuerzo de venta
  pendientes_cobro // Pendientes de cobro
  ganado
  perdido
}

enum LeadLostReason {
  precio
  demora
  no_respondio
  competencia
  otro
}

// spec 1.2 v2 · Seguro Responsable: define quién paga el trabajo y sobre
// qué compañía se imputan las estadísticas de aprobación por aseguradora.
enum InsuranceResponsibility {
  propio // Seguro del titular del vehículo cubre el trabajo
  tercero // Seguro del tercero causante paga el trabajo
  particular // Cliente paga (culpa concurrente, indemnizado, etc.)
}

model Lead {
  id           String          @id @default(uuid())
  customerId   String
  vehicleId    String?
  status       LeadStatus      @default(solicitud)
  notes        String?         @db.Text
  lostReason   LeadLostReason?
  lostNotes    String?         @db.Text
  source       String? // web, whatsapp, manual, etc.
  /**
   * Path de la carpeta en el bucket S3/MinIO donde el cliente subió fotos desde el form web (ej: "andereggen/juan-perez"). Se usa en el panel del presupuesto para listar las imágenes.
   */
  photosFolder String?         @db.VarChar(255)
  createdById  String?

  // Actores externos de la cotización (spec 4.3 + 8.1)
  inspectorId        String? // User con rol "inspector"
  insuranceAgentId   String? // User con rol "productor_seguros"
  insuranceCompanyId String? // FK a InsuranceCompany — 4to actor (spec 8.1)

  // spec 1.2 v2 · Quién es responsable de pagar. Obligatorio antes de pasar
  // el Lead a "ganado" (validación aplicada en la API de cambio de estado).
  insuranceResponsibility InsuranceResponsibility?

  // spec 1.1 + 3.1 v2 · Fecha en que se recibió la orden de trabajo (Lead
  // ganado). Las métricas de "ganados por mes" y "presupuestos por compañía"
  // se imputan a este mes, no al mes de creación del lead.
  orderReceivedAt DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  vehicle          CustomerVehicle?  @relation(fields: [vehicleId], references: [id])
  createdBy        User?             @relation("LeadCreatedBy", fields: [createdById], references: [id])
  inspector        User?             @relation("LeadInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  insuranceAgent   User?             @relation("LeadInsuranceAgent", fields: [insuranceAgentId], references: [id], onDelete: SetNull)
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  budgets          Budget[]
  repairs          Repair[]          @relation("LeadRepairs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
  @@index([createdById])
  @@index([inspectorId])
  @@index([insuranceAgentId])
  @@index([orderReceivedAt])
}

// =====================================================
// Presupuestos (Budget) — ligados a Lead, con revisiones
// =====================================================

enum BudgetStatus {
  draft
  sent
  accepted
  rejected
  expired
}

model Budget {
  id     String       @id @default(uuid())
  leadId String
  /**
   * Correlativo global del presupuesto. Las ampliaciones HEREDAN este
   * número del padre y se diferencian por `extensionSuffix`. NO es único:
   * el admin puede repetir el número manualmente si lo necesita (p. ej.,
   * para alinear con numeración externa del seguro). La identidad real
   * del registro es el `id` (uuid); el par (number, extensionSuffix) es
   * solo display.
   */
  number Int
  status BudgetStatus @default(draft)

  /**
   * 0 = presupuesto original; 1, 2, 3… = ampliaciones (A1, A2…) creadas
   * durante la reparación cuando aparece trabajo extra que el seguro
   * no había contemplado.
   */
  extensionSuffix Int             @default(0)
  /**
   * FK al presupuesto padre del que esta fila es ampliación. null si es
   * el original. onDelete Cascade: si borran el original, caen las
   * ampliaciones también.
   */
  parentBudgetId  String?
  parentBudget    Budget?         @relation("BudgetExtensions", fields: [parentBudgetId], references: [id], onDelete: Cascade)
  extensions      Budget[]        @relation("BudgetExtensions")
  /**
   * Quién paga la ampliación cuando se acepta — define a qué bucket de
   * importes aprobados del repair se suma el grandTotal. Solo aplica si
   * extensionSuffix > 0.
   */
  extensionPayer  ExtensionPayer?

  // Snapshot de cliente/vehículo al emitir (inmutable para PDF histórico)
  customerName          String
  customerEmail         String
  customerPhone         String
  customerDni           String?
  customerAddress       String?
  customerCity          String?
  vehicleBrand          String
  vehicleModel          String
  vehicleYear           String
  vehicleDomain         String
  vehicleChassis        String?
  /**
   * Pintura perlada tricapa — snapshot al momento del presupuesto
   */
  vehiclePerladoTricapa Boolean  @default(false)
  vehicleInsurance      String?
  /**
   * Tipo de cobertura: "todo_riesgo" | "terceros" — snapshot al momento del presupuesto
   */
  insuranceCoverageType String?
  /**
   * Franquicia en pesos (solo si todo_riesgo) — snapshot
   */
  insuranceFranchise    Decimal? @db.Decimal(14, 2)

  // Totales (materializados; se recalculan al guardar)
  laborSubtotal Decimal @default(0) @db.Decimal(14, 2)
  ivaRate       Decimal @default(21.00) @db.Decimal(5, 2)
  ivaAmount     Decimal @default(0) @db.Decimal(14, 2)
  laborTotal    Decimal @default(0) @db.Decimal(14, 2)
  partsSubtotal Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)

  // Observaciones (editables, defaults según PDF 7)
  validityDays     Int     @default(10)
  deliveryDays     Int     @default(20)
  paymentCondition String  @default("Contado contra entrega")
  observations     String? @db.Text
  /**
   * Aclaración libre sobre los repuestos que se proveen (sale en el PDF junto a la tabla)
   */
  partsNote        String? @db.Text

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  // spec v2 · Overrides persistidos del dialog "Fichas" (Ficha Técnica +
  // Ficha Ingreso/Egreso). Antes eran efímeros y se re-armaban desde los
  // conceptos cada vez; ahora si el usuario edita y guarda, quedan
  // asociados al budget y se repiten al reabrir. Shape:
  //   { tecnica?: { color, sections: [{title, bullets[]}] },
  //     ingreso?: { date, insurance, technicalInsurance, franchiseAmount,
  //                 franchiseLabel, paymentCondition, customerName,
  //                 customerAddress, customerLocality, customerPhone } }
  fichasOverrides Json?

  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  concepts      BudgetConcept[]
  parts         BudgetPart[]
  partMovements PartMovement[]
  payments      Payment[]
  emailLogs     BudgetEmailLog[]
  adminItems    BudgetAdminItem[]
  repair        Repair?           @relation("BudgetRepair")
  createdById   String?
  createdBy     User?             @relation("BudgetCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([parentBudgetId])
  @@index([number])
}

/**
 * Quién paga una ampliación cuando se acepta. Define a qué bucket de los
 * "Importes Aprobados" del Repair se suma el grandTotal de la ampliación.
 */
enum ExtensionPayer {
  SEGURO
  FRANQUICIA
  PARTICULAR
}

/**
 * Pestaña "Administrativa" del presupuesto — uso 100% interno (no sale en PDF).
 * Reemplaza la pestaña Excel donde antes se cargaban cotizaciones de proveedores
 * (pre-cierre) y compras efectivamente realizadas (durante producción).
 * Estructura:
 * BudgetAdminItem  — un repuesto a cotizar (descripción + fotos como URLs)
 * ├── BudgetAdminQuote (N)   — cotizaciones de N proveedores para ese repuesto
 * └── BudgetAdminPurchase (0..1) — la compra final realmente hecha
 */
model BudgetAdminItem {
  id          String   @id @default(uuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  description String   @db.Text
  notes       String?  @db.Text
  /**
   * URLs de imágenes (Drive, etc.) — el cliente pega links, no hay upload aún
   */
  photos      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes    BudgetAdminQuote[]
  /**
   * spec Compras v2 · Puede haber N Purchases por item (devoluciones +
   * recompras). El "activa" es el último no ARCHIVADA.
   */
  purchases Purchase[]

  @@index([budgetId])
}

/**
 * Categoría de la cotización: define en qué columna del comparativo aparece.
 * - OFICIAL: precio en concesionaria oficial de la marca.
 * - ALTERNATIVO: repuesto alternativo (proveedor independiente).
 * - DESARMADERO: repuesto usado de desarmadero.
 * Un mismo repuesto puede tener varias cotizaciones por categoría.
 */
enum QuoteCategory {
  OFICIAL
  ALTERNATIVO
  DESARMADERO
}

model BudgetAdminQuote {
  id           String          @id @default(uuid())
  itemId       String
  item         BudgetAdminItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /**
   * Bucket de la grilla comparativa (concesionaria/alternativo/desarmadero).
   */
  category     QuoteCategory   @default(OFICIAL)
  /**
   * spec Compras v2 · Proveedor del catálogo (opcional). `supplierName` se
   * mantiene como snapshot para históricos si el Supplier se borra/renombra.
   */
  supplierId   String?
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String
  price        Decimal         @db.Decimal(14, 2)
  /**
   * Código de repuesto que da el proveedor (puede repetirse entre proveedores)
   */
  partCode     String?
  /**
   * Descuento en porcentaje 0–100 — el neto se calcula price * (1 - discount/100)
   */
  discount     Decimal?        @db.Decimal(5, 2)
  /**
   * Disponibilidad declarada por el proveedor (texto libre: "En stock", "3 días", etc.)
   */
  availability String?
  /**
   * URLs de fotos asociadas a esta cotización (Drive, etc.)
   */
  photos       String[]
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  /**
   * Purchases que eligieron esta cotización (0..N si hubo recompras).
   */
  purchases Purchase[] @relation("PurchaseChosenQuote")

  @@index([itemId])
  @@index([itemId, category])
  @@index([supplierId])
}

// ─────────────────────────────────────────────────────────────
// Módulo Compras v2 — spec jul '26
// ─────────────────────────────────────────────────────────────
// Máquina de 7 estados para gestionar cada compra desde la cotización hasta
// el archivo. Cada `BudgetAdminItem` puede tener N Purchases (devoluciones
// + recompras). La "activa" es la más reciente que no esté ARCHIVADA.
//
// El brief pide que la compra pueda RETROCEDER de estado (ej. llegó dañada
// y hay que volver a "En camino"). No hay guardias en el enum — todas las
// transiciones son posibles desde la UI.

enum PurchaseStatus {
  COTIZAR // Se cargan repuestos y cotizaciones — sin decisión aún
  DECIDIR // Cotizaciones listas, falta elegir cuál comprar
  COMPRAR // Cotización elegida, hay que gestionar la compra con el proveedor
  EN_CAMINO // Compra efectuada, pieza en tránsito
  EN_TALLER // Repuesto llegó (setea receivedAt → dispara Repair.partsReceivedAt)
  PENDIENTE_PAGO // Llegó pero todavía no se pagó (repuesto y/o flete)
  ARCHIVADA // Compra cerrada
}

/**
 * Catálogo único de proveedores — spec Compras v2.
 * Usado por cotizaciones y por fletes (sin separar por tipo). Nullable en
 * las relaciones para no perder registros históricos si un proveedor se borra.
 */
model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String?
  email     String?
  address   String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes           BudgetAdminQuote[]
  purchases        Purchase[]         @relation("PurchasePartsSupplier")
  freightPurchases Purchase[]         @relation("PurchaseFreightSupplier")

  @@index([isActive])
}

model Purchase {
  id     String          @id @default(uuid())
  itemId String
  item   BudgetAdminItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /**
   * spec Compras v2 · N° de compra propio, formato
   * `<budget.number|"INT-"+internalNumber>.<seq>` (ej. 4056.1, 4056.2,
   * INT-192.1). Único en toda la app para poder linkear desde caja.
   */
  number String @unique

  status PurchaseStatus @default(COTIZAR)

  /**
   * Cotización elegida (opcional al inicio, obligatoria a partir de COMPRAR).
   * Al tildar el checkbox en "Decidir", se materializa acá.
   */
  chosenQuoteId String?
  chosenQuote   BudgetAdminQuote? @relation("PurchaseChosenQuote", fields: [chosenQuoteId], references: [id], onDelete: SetNull)

  /**
   * Snapshot de categoría/proveedor por si la quote se borra o cambia.
   */
  category     QuoteCategory?
  supplierId   String?
  supplier     Supplier?      @relation("PurchasePartsSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?

  /**
   * Monto real pagado (puede diferir de la cotización elegida).
   */
  amount Decimal @default(0) @db.Decimal(14, 2)

  /**
   * Flete manual por producto. Si un envío trae varios repuestos, se
   * prorratea manualmente cargando el importe correspondiente en cada uno.
   */
  freightAmount       Decimal   @default(0) @db.Decimal(14, 2)
  freightSupplierId   String?
  freightSupplier     Supplier? @relation("PurchaseFreightSupplier", fields: [freightSupplierId], references: [id], onDelete: SetNull)
  freightSupplierName String?

  /**
   * Fechas clave del ciclo. `receivedAt` dispara notif de "repuestos
   * recibidos" y setea `Repair.partsReceivedAt` si aún no estaba.
   */
  purchasedAt DateTime?
  receivedAt  DateTime?
  archivedAt  DateTime?

  /**
   * Pago separado por concepto. Cada uno se vincula al CashMovement EGRESO
   * que se genera cuando se marca como pagado desde Caja.
   */
  paidPartsAt           DateTime?
  paidPartsMovementId   String?       @unique
  paidPartsMovement     CashMovement? @relation("PurchasePartsPayment", fields: [paidPartsMovementId], references: [id], onDelete: SetNull)
  paidFreightAt         DateTime?
  paidFreightMovementId String?       @unique
  paidFreightMovement   CashMovement? @relation("PurchaseFreightPayment", fields: [paidFreightMovementId], references: [id], onDelete: SetNull)

  receiptUrl String?
  notes      String? @db.Text

  createdById String?
  createdBy   User?    @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([supplierId])
  @@index([freightSupplierId])
  @@index([purchasedAt])
}

/**
 * Log de envíos del presupuesto por email. Permite auditar cuándo se envió
 * y a quién (cliente, perito, productor, otros).
 */
model BudgetEmailLog {
  id          String   @id @default(uuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sentAt      DateTime @default(now())
  sentById    String?
  sentBy      User?    @relation("BudgetEmailSentBy", fields: [sentById], references: [id])
  // Destinatarios: json { customer?, inspector?, insurance?, others?: string[] }
  recipients  Json
  subject     String
  messageBody String?  @db.Text
  /**
   * "sent" | "failed"
   */
  status      String   @default("sent")
  errorMsg    String?  @db.Text
  messageId   String? // nodemailer messageId para tracking

  @@index([budgetId, sentAt])
}

enum ConceptType {
  DESCRIPTIVO // multiselect de subdetalles + detalle adicional, sin importe
  UNIDADES // unidades × valorUnitario
  FIJO // importe fijo editable
}

enum ConceptCategory {
  // Descriptivos
  DESMONTAR
  DESMONTAR_Y_REPARAR
  DESMONTAR_Y_CAMBIAR
  BANCADA_DE_ESTIRAMIENTO
  DESABOLLAR
  DIFUMINAR
  // Unidades
  CHAPA
  PINTURA
  // Fijos
  MECANICA
  ALINEACION_BALANCEO
  AIRE_ACONDICIONADO
  AIRBAGS
  COLOCACION_PARABRISAS
  COLOCACION_LUNETA
  PULIDO_COMPLETO
  OTROS_ADICIONALES
}

model BudgetConcept {
  id       String          @id @default(uuid())
  budgetId String
  type     ConceptType
  category ConceptCategory
  order    Int             @default(0)

  // DESCRIPTIVO
  subdetails       String[] // keys del catálogo TS
  additionalDetail String?  @db.Text

  // UNIDADES
  units     Decimal? @db.Decimal(10, 2)
  unitValue Decimal? @db.Decimal(14, 2)

  // FIJO
  fixedAmount      Decimal? @db.Decimal(14, 2)
  fixedDescription String?  @db.Text // textarea para OTROS_ADICIONALES

  // Subtotal materializado del concepto (0 para DESCRIPTIVO)
  subtotal Decimal @default(0) @db.Decimal(14, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
}

model BudgetPart {
  id          String  @id @default(uuid())
  budgetId    String
  partId      String? // opcional — si viene del catálogo
  order       Int     @default(0)
  quantity    Decimal @db.Decimal(10, 2)
  description String
  unitPrice   Decimal @db.Decimal(14, 2)
  subtotal    Decimal @db.Decimal(14, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  part   Part?  @relation(fields: [partId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([partId])
}

// =====================================================
// Inventario — Catálogo de repuestos + stock + movimientos
// =====================================================

enum PartCategory {
  CARROCERIA
  CRISTALERIA
  MECANICA
  ELECTRICO
  PINTURA
  FRENOS
  SUSPENSION
  FILTROS
  ILUMINACION
  INTERIOR
  OTROS
}

model Part {
  id          String       @id @default(uuid())
  sku         String?      @unique // código interno (opcional)
  name        String
  description String?      @db.Text
  brand       String? // marca del repuesto (p/ej OEM, Bosch)
  appliesTo   String? // modelos/marcas de vehículo a los que aplica (texto libre)
  category    PartCategory @default(OTROS)
  costPrice   Decimal      @default(0) @db.Decimal(14, 2)
  salePrice   Decimal      @default(0) @db.Decimal(14, 2)
  stockQty    Decimal      @default(0) @db.Decimal(12, 2) // cantidad actual
  stockMin    Decimal      @default(0) @db.Decimal(12, 2) // umbral de alerta
  isActive    Boolean      @default(true)

  budgetParts BudgetPart[]
  movements   PartMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([name])
}

enum PartMovementType {
  IN // entrada (compra, devolución del taller)
  OUT // salida (consumo en reparación)
  ADJUST // ajuste manual (correcciones de inventario)
}

model PartMovement {
  id          String           @id @default(uuid())
  partId      String
  type        PartMovementType
  qty         Decimal          @db.Decimal(12, 2) // siempre positiva; el signo lo define el type
  reason      String // motivo libre
  note        String?          @db.Text
  budgetId    String? // si el movimiento surgió de un presupuesto
  createdById String?

  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  budget    Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("PartMovementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([partId])
  @@index([type])
  @@index([budgetId])
  @@index([createdById])
  @@index([createdAt])
}

// =====================================================
// Herramientas (activos físicos del taller) — se asignan a usuarios
// =====================================================

enum ToolCategory {
  NEUMATICA
  HIDRAULICA
  ELECTRICA
  MANUAL
  ELEVACION
  SOLDADURA
  PINTURA
  DIAGNOSTICO
  OTROS
}

enum ToolStatus {
  AVAILABLE // disponible en depósito
  IN_USE // asignada a un usuario
  MAINTENANCE // en reparación/calibración
  RETIRED // dada de baja
}

model Tool {
  id           String       @id @default(uuid())
  code         String?      @unique // código interno / patrimonial
  name         String
  description  String?      @db.Text
  brand        String?
  category     ToolCategory @default(OTROS)
  status       ToolStatus   @default(AVAILABLE)
  assignedToId String? // FK a User (si IN_USE)
  location     String? // depósito, box 1, etc.
  cost         Decimal      @default(0) @db.Decimal(14, 2)
  acquiredAt   DateTime? // fecha de compra / incorporación
  notes        String?      @db.Text
  isActive     Boolean      @default(true)

  assignedTo User? @relation("ToolAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([assignedToId])
  @@index([isActive])
}

// =====================================================
// Configuración general del sistema
// =====================================================

/**
 * Singleton — id fijo "app". Se lee/actualiza siempre la misma fila.
 * Agrupa todos los settings globales para evitar múltiples tablas chicas.
 */
model AppSettings {
  id String @id @default("app")

  // Empresa (aparece en PDFs, emails, header del dashboard)
  companyName    String  @default("Andereggen Taller Automotor")
  companyAddress String  @default("Aconcagua 663 — Rafaela, Santa Fe")
  companyCuit    String?
  companyPhone   String?
  companyEmail   String?
  companyWebsite String?
  companyLogoUrl String? @db.Text

  // Defaults de presupuesto
  defaultIvaRate          Decimal @default(21.00) @db.Decimal(5, 2)
  defaultValidityDays     Int     @default(10)
  defaultDeliveryDays     Int     @default(20)
  defaultPaymentCondition String  @default("Contado contra entrega")

  // Notificaciones automáticas
  notifyOnLeadCreated    Boolean @default(true)
  notifyOnBudgetSent     Boolean @default(true)
  notifyOnBudgetReminder Boolean @default(true)
  notifyOnStageChange    Boolean @default(true)
  reminderDaysAfterSent  Int     @default(5)

  // Notificaciones automáticas — spec sección 6 (5 eventos) + spec 2.1/1.3 v2 (2 eventos)
  notifyBudgetCreated      Boolean @default(true) // Presupuesto generado → Cliente + Inspector + Productor
  notifyVehicleEntered     Boolean @default(true) // Vehículo ingresado al taller → Cliente + Productor
  notifyPartsReceived      Boolean @default(true) // Repuestos recibidos → Inspector + Productor
  notifyRepairCompleted    Boolean @default(true) // Reparación completada / listo para retirar → Cliente + Inspector + Productor
  notifyCustomerExperience Boolean @default(true) // Solicitud de experiencia del cliente → Cliente
  notifyTurnAssigned       Boolean @default(true) // spec 2.1 v2 · Turno coordinado → Cliente
  notifyLeadReinforcement  Boolean @default(true) // spec 1.3 v2 · Lead movido a "Refuerzo" → Cliente

  // Apariencia / localización
  locale   String @default("es-AR")
  currency String @default("ARS")
  timezone String @default("America/Argentina/Buenos_Aires")

  // Integraciones (feature flags + placeholders)
  whatsappEnabled Boolean @default(false)
  whatsappNumber  String?
  whatsappApiKey  String?
  mpEnabled       Boolean @default(false)
  mpAccessToken   String?
  afipEnabled     Boolean @default(false)
  afipCuit        String?
  afipCertNote    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Aseguradoras con las que trabaja el taller.
 * Usado como autocomplete en VehicleForm (seguro/seguroTerceros).
 */
model InsuranceCompany {
  id          String  @id @default(uuid())
  name        String  @unique
  phone       String?
  email       String?
  contactName String?
  notes       String? @db.Text
  isActive    Boolean @default(true)

  // Leads vinculados a esta aseguradora (spec 8.1 — 4to actor)
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/**
 * Fuentes de lead (web, whatsapp, manual, referido, etc.).
 * Hoy Lead.source es String libre; esta tabla da un catálogo consistente.
 */
model LeadSource {
  id       String  @id @default(uuid())
  key      String  @unique // slug estable, ej: "web"
  label    String // display, ej: "Web"
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/**
 * Catálogo de marcas de vehículos (Toyota, Ford, VW, etc.).
 * Usado como autocomplete en VehicleForm / LeadCanvas.
 * Los valores guardados en CustomerVehicle.brand son strings libres:
 * este catálogo sugiere pero no fuerza.
 */
model VehicleBrand {
  id       String         @id @default(uuid())
  name     String         @unique
  isActive Boolean        @default(true)
  models   VehicleModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/**
 * Modelos de vehículos asociados a una marca (Etios, Fiesta, Gol, etc.).
 * Unique compuesto (brandId, name): el mismo modelo no se duplica dentro de la marca.
 */
model VehicleModel {
  id       String       @id @default(uuid())
  brandId  String
  brand    VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  isActive Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, name])
  @@index([brandId, isActive])
}

// =====================================================
// Producción — Órdenes de reparación (Kanban de producción)
// =====================================================

/**
 * Estados del Kanban de Producción. Orden visual exacto (definido en
 * src/components/production/production-kanban.tsx COLUMNS):
 * 1. turno_asignado, 2. pendientes_repuestos, 3. chapa, 4. pintura,
 * 5. calidad, 6. pendientes_cobro, 7. experiencia_cliente, 8. archivado
 * Cuando se carga la fecha de ingreso del vehículo (desde el form de la
 * card), el status pasa automáticamente de turno_asignado a chapa y se
 * dispara la notificación "vehicle_entered" al cliente.
 * "pendientes_repuestos" representa el paso intermedio entre el ingreso
 * del vehículo y el comienzo de la chapa: el vehículo está en taller
 * esperando que lleguen los repuestos pedidos.
 * "pendientes_cobro" es la etapa después de calidad: el trabajo está
 * terminado y falta cobrar para que el cliente pueda retirar el vehículo.
 * "experiencia_cliente" es la última etapa antes del archivo: una vez
 * cobrado y entregado, se le pide al cliente que califique el servicio.
 * NOTA: el orden de los valores en el enum NO coincide con el orden
 * visual — Postgres mantiene el orden histórico en el que se agregaron.
 * "ingresado" se mantiene aquí como deprecated (no se usa más en el
 * flujo nuevo, pero Postgres no permite remover valores de enum sin
 * recrear el tipo). Se migró todo a "chapa" en
 * 20260425180000_remove_ingresado_column_from_kanban.
 */
enum RepairStatus {
  turno_asignado
  ingresado // @deprecated — removido del Kanban; data migrada a chapa
  pendientes_repuestos
  chapa
  pintura
  calidad
  experiencia_cliente
  pendientes_cobro
  archivado
  // spec 2.1 v2 · Estado inicial cuando la oportunidad se gana pero todavía
  // no se coordinó turno con el cliente. Al setear `scheduledAt` en la ficha
  // pasa automáticamente a `turno_asignado`. Agregado al final porque
  // Postgres mantiene el orden histórico del enum.
  turno_a_asignar
}

/**
 * Orden de reparación. Puede originarse:
 * - Desde un Budget aceptado (leadId + budgetId presentes).
 * - Directa desde el módulo de Producción (botón "Nueva Reparación" —
 * ambos en null, directCreation=true).
 * Siempre tiene snapshot de cliente/vehículo (como Budget) para integridad
 * histórica aunque Customer/CustomerVehicle se editen después.
 */
model Repair {
  id             String       @id @default(uuid())
  status         RepairStatus @default(turno_asignado)
  /**
   * Nº interno del taller — correlativo único, auto-asignado al crear
   * (max+1), editable después. Se usa en Ficha Técnica y para
   * identificar la reparación visualmente. Nullable para repairs
   * importados antes de que existiera este campo.
   */
  internalNumber Int?         @unique

  // Origen (opcional — null si fue Nueva Reparación directa)
  leadId   String?
  lead     Lead?   @relation("LeadRepairs", fields: [leadId], references: [id], onDelete: SetNull)
  budgetId String? @unique
  budget   Budget? @relation("BudgetRepair", fields: [budgetId], references: [id], onDelete: SetNull)

  // Flag de creación directa (sin presupuesto)
  directCreation Boolean @default(false)

  // Referencias al catálogo (opcionales, para edición posterior)
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId  String?
  vehicle    CustomerVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Snapshot de cliente/vehículo al abrir la reparación (inmutable)
  customerName  String
  customerEmail String
  customerPhone String
  vehicleBrand  String
  vehicleModel  String
  vehicleYear   String
  vehicleDomain String

  // Motivo de ingreso — texto libre (obligatorio en Nueva Reparación directa)
  reason String? @db.Text

  // Asignación y fechas clave por etapa
  assignedMechanicId  String?
  assignedMechanic    User?     @relation("RepairMechanic", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  scheduledAt         DateTime? // turno asignado
  enteredAt           DateTime? // cuando físicamente ingresa al taller
  partsReceivedAt     DateTime? // col. "Repuestos Recibidos"
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  archivedAt          DateTime?
  // spec 2.3 v2 · El cliente pidió que lo lleven a su domicilio/trabajo al
  // dejar el vehículo. Se muestra como checkbox en el calendario y en la
  // ficha del repair. Es sobre la persona, no el vehículo.
  needsTransport      Boolean   @default(false)

  // Compañía de seguro que paga — snapshot al crear el repair. Visible en
  // la card del kanban mientras el auto está en taller. Texto libre porque
  // en directCreation puede no haber FK a InsuranceCompany.
  insuranceCompany String?

  // Importes aprobados por el seguro / acordados con el cliente. Pueden
  // diferir del grandTotal del presupuesto cuando el seguro recorta.
  approvedInsurance Decimal?  @db.Decimal(14, 2)
  approvedFranchise Decimal?  @db.Decimal(14, 2)
  approvedCustomer  Decimal?  @db.Decimal(14, 2)
  approvedAt        DateTime?
  approvedNotes     String?   @db.Text

  // Facturación + cobros (varias facturas por reparación: cliente/seguro
  // separadas, cada una con sus pagos parciales).
  invoices RepairInvoice[]

  // Meta
  notes String? @db.Text

  createdById String?
  createdBy   User?   @relation("RepairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Encuesta de satisfacción (spec 6 "Solicitud de experiencia del cliente" + E2.B)
  serviceRating ServiceRating?

  @@index([status])
  @@index([leadId])
  @@index([assignedMechanicId])
  @@index([archivedAt])
  @@index([customerId])
}

/**
 * Encuesta de satisfacción del cliente (E2.B + spec sección 6).
 * Se genera automáticamente cuando la reparación pasa a estado
 * "experiencia_cliente" y se envía al cliente un email con un link
 * público `/reviews/[token]` para que califique sin necesidad de login.
 */
model ServiceRating {
  id          String    @id @default(uuid())
  repairId    String    @unique
  repair      Repair    @relation(fields: [repairId], references: [id], onDelete: Cascade)
  /**
   * Token opaco único — va en la URL pública /reviews/[token].
   */
  token       String    @unique
  /**
   * null hasta que el cliente responde. Al responder se setea 1-5.
   */
  stars       Int?
  comment     String?   @db.Text
  respondedAt DateTime?
  /**
   * IP de quien respondió (auditoría mínima).
   */
  respondedIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([respondedAt])
}

// =====================================================
// Cobros / Pagos sobre presupuestos aceptados
// =====================================================

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
  MERCADOPAGO
  OTRO
}

model Payment {
  id          String        @id @default(uuid())
  budgetId    String
  amount      Decimal       @db.Decimal(14, 2)
  paidAt      DateTime      @default(now())
  method      PaymentMethod @default(EFECTIVO)
  reference   String? // número de transferencia, cheque, ticket MP, etc.
  notes       String?       @db.Text
  createdById String?

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([budgetId])
  @@index([paidAt])
  @@index([method])
  @@index([createdById])
}

// =====================================================
// Facturación por reparación
// =====================================================
// El flujo real del taller: una vez que el auto se retira y queda en
// "pendientes de cobro", se emiten una o varias facturas (típico: una
// al cliente por la franquicia y otra al seguro por el resto). Cada
// factura puede cobrarse en N pagos parciales y tener un saldo pendiente
// que se calcula como `amount - sum(payments.amount)`.

enum InvoiceRecipient {
  CLIENTE
  SEGURO
  OTRO
}

model RepairInvoice {
  id            String           @id @default(uuid())
  repairId      String
  repair        Repair           @relation(fields: [repairId], references: [id], onDelete: Cascade)
  /**
   * Número/identificador de la factura (texto libre: "FACT 5187", "A-001-0042").
   */
  number        String
  issuedAt      DateTime
  recipient     InvoiceRecipient @default(CLIENTE)
  /**
   * Nombre legible del destinatario — la compañía de seguro o nombre del cliente.
   */
  recipientName String?
  /**
   * Importe total facturado (sin descontar pagos).
   */
  amount        Decimal          @db.Decimal(14, 2)
  notes         String?          @db.Text

  payments RepairInvoicePayment[]

  createdById String?
  createdBy   User?   @relation("RepairInvoiceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairId])
  @@index([issuedAt])
}

model RepairInvoicePayment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   RepairInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(14, 2)
  paidAt    DateTime      @default(now())
  method    PaymentMethod @default(EFECTIVO)
  reference String?
  notes     String?       @db.Text

  // spec 4.2 v2 · Caja destino del cobro. Nullable para cobros históricos
  // y para cobros en los que el operador no eligió caja (quedan sin imputar).
  cashBoxId String?
  cashBox   CashBox? @relation(fields: [cashBoxId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("RepairInvoicePaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
  @@index([cashBoxId])
}

// =====================================================
// Módulo Caja — spec sección 4 v2
// =====================================================
// Trazabilidad de dónde está el dinero en cada momento. Las 5 cajas no son
// por usuario sino un registro contable del flujo entre personas y métodos.
// Los cobros de facturas (RepairInvoicePayment.cashBoxId) alimentan la vista
// automáticamente; CashMovement se usa para egresos y transferencias entre
// cajas — no duplicamos los cobros ahí.

enum CashMovementType {
  INGRESO // Ingreso manual (aportes, ventas fuera de reparación)
  EGRESO // Gastos, retiros, sueldos
  TRANSFER_IN // Contraparte "recibí" de una transferencia interna
  TRANSFER_OUT // Contraparte "envié" de una transferencia interna
  // spec v2 · "Pases" — dinero que entra o sale de la caja pero no es
  // ingreso/egreso contable. Suele ser retiro temporal que después vuelve
  // (ej: María se lleva $500k y los devuelve la semana siguiente). Cuentan
  // para el saldo pero NO para "Ingresos/Egresos del mes" ni facturación.
  PASE_IN
  PASE_OUT
}

model CashBox {
  id          String    @id @default(uuid())
  /**
   * Slug estable — se seedea con "caja_1", "caja_2", "caja_maria",
   * "caja_alfredo", "caja_lucila". Se usa para features que necesitan
   * identificar una caja específica sin depender del UUID.
   */
  key         String    @unique
  name        String
  description String?   @db.Text
  /**
   * Orden de despliegue en la UI.
   */
  sortOrder   Int       @default(0)
  archivedAt  DateTime?

  movements       CashMovement[]
  payments        RepairInvoicePayment[]
  pendingPayments PendingCashPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CashMovement {
  id        String           @id @default(uuid())
  cashBoxId String
  cashBox   CashBox          @relation(fields: [cashBoxId], references: [id], onDelete: Cascade)
  type      CashMovementType
  amount    Decimal          @db.Decimal(14, 2)
  method    PaymentMethod    @default(EFECTIVO)
  /**
   * Descripción libre — "Alquiler local", "Salario María", "Transferencia
   * a Caja 1", etc. Obligatorio para poder auditar el movimiento.
   */
  concept   String
  reference String?
  notes     String?          @db.Text

  /**
   * Para transferencias entre cajas: los dos rows (TRANSFER_OUT origen y
   * TRANSFER_IN destino) comparten este UUID. Permite mostrar la
   * contraparte y evitar contar dos veces al agregar totales globales.
   */
  transferGroupId String?

  paidAt      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /**
   * spec Compras v2 · Un CashMovement EGRESO puede haber sido generado
   * automáticamente al marcar como pagada la parte de repuestos o de flete
   * de una Purchase. Ambas relaciones son inversas de Purchase (`@unique`
   * en el lado Purchase).
   */
  purchasePartsPayment   Purchase? @relation("PurchasePartsPayment")
  purchaseFreightPayment Purchase? @relation("PurchaseFreightPayment")

  @@index([cashBoxId])
  @@index([paidAt])
  @@index([transferGroupId])
}

// spec v2 · Pagos preparados / para realizar.
// Los usa el equipo para anotar "esto lo vamos a pagar el viernes" antes
// de retirar la plata. Cuando se materializa (mark-paid), se crea el
// CashMovement EGRESO correspondiente en la caja y el registro queda
// como PAGADO con `paidAt` seteado.
enum PendingCashPaymentStatus {
  PENDIENTE
  PAGADO
  CANCELADO
}

model PendingCashPayment {
  id        String                   @id @default(uuid())
  cashBoxId String
  cashBox   CashBox                  @relation(fields: [cashBoxId], references: [id], onDelete: Cascade)
  amount    Decimal                  @db.Decimal(14, 2)
  method    PaymentMethod            @default(EFECTIVO)
  concept   String
  reference String?
  notes     String?                  @db.Text
  /**
   * Fecha estimada de pago (opcional — para ordenar por lo más próximo).
   */
  dueDate   DateTime?
  status    PendingCashPaymentStatus @default(PENDIENTE)

  /**
   * Cuándo se materializó y a qué CashMovement se ligó.
   */
  paidAt           DateTime?
  paidByMovementId String?   @unique

  createdById String?
  createdBy   User?   @relation("PendingCashPaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashBoxId])
  @@index([status])
  @@index([dueDate])
}

// spec KPIs jul '26 · Valores MANUALES del tablero de KPIs.
// La regla general es que TODO KPI calculable desde el back office debe ser
// Automático (se calcula on-the-fly desde Lead/Repair/Cash*). Este modelo
// existe solo para los datos que no salen del sistema — por ahora solo
// "reclamos" del mes, pero queda genérico por si suman más manuales.
//
// Un valor por (metricKey, year, month). Al editar se hace upsert.
model MonthlyKpiEntry {
  id        String  @id @default(uuid())
  /**
   * Clave estable del catálogo — ej: "produccion.reclamos". Se valida
   * contra `MANUAL_KPI_CATALOG` en runtime al guardar.
   */
  metricKey String  @db.VarChar(80)
  year      Int
  /**
   * 1-12 (enero = 1).
   */
  month     Int
  value     Decimal @db.Decimal(14, 2)
  notes     String? @db.Text

  createdById String?
  createdBy   User?   @relation("MonthlyKpiEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metricKey, year, month])
  @@index([metricKey])
  @@index([year, month])
}
